# Every Gradle module: its build output, and Gradle's and Kotlin's caches
.gradle/
.kotlin/
build/
# A source package named build, such as buildSrc's me.ahoo.cosky.build
!**/src/**/build/
# Committed, even where a global ignore file leaves out jars
!gradle/wrapper/gradle-wrapper.jar

# A JVM that crashed or dumped its heap
hs_err_pid*.log
replay_pid*.log
*.hprof

# IDEs
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db

# The Node projects, dashboard/ and wiki/, have their own .gitignore.
