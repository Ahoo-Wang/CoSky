{
  "name": "cosky-dashboard",
  "private": true,
  "version": "5.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --fix",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:ui": "playwright test",
    "test:coverage": "COSKY_COVERAGE=1 playwright test tests/ui/dashboard.spec.ts",
    "test:ui:real": "playwright test tests/ui/real-backend.spec.ts --workers=1",
